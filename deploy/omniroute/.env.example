# Copy this file to .env and replace every placeholder.
# Generate secrets with: openssl rand -base64 48 / openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_RANDOM_BASE64_SECRET
API_KEY_SECRET=REPLACE_WITH_RANDOM_HEX_SECRET
INITIAL_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_ADMIN_PASSWORD

# Persistent database and API security
DATA_DIR=/data
REQUIRE_API_KEY=true
